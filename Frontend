function completePayment() {
    const paymentMethod = document.getElementById('paymentMethod').value;
    const paymentDetails = document.getElementById('paymentDetails').value.trim();
    let validationPassed = false;
    let errorMessage = '';

    if (!paymentDetails) {
        alert('❌ कृपया भुगतान विवरण (Payment Details) दर्ज करें।');
        return;
    }

    switch (paymentMethod) {
        case 'upi':
            // UPI ID format: example@bank, example.user@okicici
            if (/^[a-zA-Z0-9.\-]+@[a-zA-Z0-9\-]+$/.test(paymentDetails)) {
                validationPassed = true;
            } else {
                errorMessage = '❌ अमान्य UPI ID प्रारूप। कृपया एक मान्य ID डालें (उदा: user@bank)।';
            }
            break;
        case 'card':
            // Simple 16-digit card number check
            if (/^\d{16}$/.test(paymentDetails)) {
                validationPassed = true;
            } else {
                errorMessage = '❌ अमान्य कार्ड नंबर। कृपया 16 अंकों का कार्ड नंबर डालें।';
            }
            break;
        default:
            // For Netbanking/Wallet, a non-empty detail is accepted for this simple demo
            validationPassed = true;
            break;
    }

    if (!validationPassed) {
        alert(errorMessage);
        return;
    }
    
    // ... (rest of the payment logic)
    closeModal('paymentModal');

    // Simulate payment processing
    setTimeout(() => {
        const passData = {
            passId: 'BP' + Date.now(),
            userId: currentUser.userId,
            passType: selectedPassType,
            fromStop: document.getElementById('fromStop').value,
            toStop: document.getElementById('toStop').value,
            passengerName: document.getElementById('passengerName').value,
            mobile: document.getElementById('mobileNumber').value,
            email: document.getElementById('emailAddress').value,
            amount: document.getElementById('totalAmount').textContent,
            purchaseDate: new Date().toISOString(),
            expiryDate: calculateExpiry(selectedPassType),
            status: 'active'
        };

        // Save to DynamoDB
        savePassToDB(passData);

        // Generate QR Code
        generateQRCode(passData.passId);
        document.getElementById('passId').textContent = passData.passId;
        
        document.getElementById('successModal').classList.add('active');
    }, 1500);
}
        function calculateExpiry(type) {
            const now = new Date();
            if (type === 'daily') {
                now.setDate(now.getDate() + 1);
            } else if (type === 'weekly') {
                now.setDate(now.getDate() + 7);
            } else if (type === 'monthly') {
                now.setDate(now.getDate() + 30);
            }
            return now.toISOString();
        }

        function generateQRCode(passId) {
            const canvas = document.getElementById('qrCanvas');
            const ctx = canvas.getContext('2d');
            canvas.width = 180;
            canvas.height = 180;
            
            // Simple QR-like pattern (in production, use a real QR library)
            ctx.fillStyle = '#000';
            ctx.fillRect(0, 0, 180, 180);
            ctx.fillStyle = '#fff';
            ctx.fillRect(10, 10, 160, 160);
            ctx.fillStyle = '#000';
            ctx.font = '12px monospace';
            ctx.fillText(passId, 20, 90);
            
            // Draw random pattern
            for (let i = 0; i < 50; i++) {
                const x = Math.random() * 140 + 20;
                const y = Math.random() * 140 + 20;
                const size = Math.random() * 5 + 2;
                ctx.fillRect(x, y, size, size);
            }
        }




