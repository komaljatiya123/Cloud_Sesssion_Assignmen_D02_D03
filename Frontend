async function loadPasses() {
    if (!currentUser) {
        document.getElementById('passList').innerHTML = '<p style="text-align: center; color: #6b7280; padding: 40px 0;">Please login to view your passes</p>';
        return;
    }

    try {
        // 🛑 Local Storage Logic ko Hataayein/Comment karein
        // const passes = JSON.parse(localStorage.getItem('userPasses_' + currentUser.userId) || '[]');

        // 🛑 API Gateway Call: Uncomment these lines
        const response = await fetch(`${API_BASE_URL}/passes/${currentUser.userId}`, {
             method: 'GET'
        });

        if (response.ok) {
            const passes = await response.json();
            
            if (passes.length === 0) {
                document.getElementById('passList').innerHTML = '<p style="text-align: center; color: #6b7280; padding: 40px 0;">No passes purchased yet</p>';
                return;
            }

            // Display logic (rest of the code - same rakhein)
            let html = '';
            passes.forEach(pass => {
                const isExpired = new Date(pass.expiryDate) < new Date();
                // ... (HTML content)
                html += `
                    <div class="pass-item ${isExpired ? 'expired' : ''}">
                        <h4>${pass.passType.toUpperCase()} PASS</h4>
                        <p><strong>Pass ID:</strong> ${pass.passId}</p>
                        <p><strong>Route:</strong> ${pass.fromStop} → ${pass.toStop}</p>
                        <p><strong>Valid Till:</strong> ${new Date(pass.expiryDate).toLocaleDateString('en-IN')}</p>
                        <p><strong>Amount:</strong> ${pass.amount}</p>
                        <span class="status-badge ${isExpired ? 'status-expired' : 'status-active'}">
                            ${isExpired ? 'Expired' : 'Active'}
                        </span>
                    </div>
                `;
            });

            document.getElementById('passList').innerHTML = html;
        } else {
             console.error('API Error loading passes:', response.status);
        }
        
    } catch (error) {
         console.error('Error loading passes:', error);
    }
}
        

        function showMyPasses() {
            loadPasses();
        }

