             body: JSON.stringify(userData)
        });
        
        if (response.ok) {
             console.log('User saved to AWS:', userData);
        } else {
             console.error('API Error saving user:', response.status);
        }

    } catch (error) {
        console.error('Error saving user:', error);
    }
}
