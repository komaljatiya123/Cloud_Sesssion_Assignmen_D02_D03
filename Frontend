             function isValidName(name) {
    // केवल अक्षर और स्पेस (Only letters and spaces)
    return /^[a-zA-Z\s]+$/.test(name);
}

function isValidMobile(mobile) {
    // ठीक 10 अंक (Exactly 10 digits)
    return /^\d{10}$/.test(mobile);
}

function isValidEmail(email) {
    // मानक ईमेल प्रारूप (Standard email format)
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

// Login फंक्शन में बाधाएं
function login() {
    const mobile = document.getElementById('loginMobile').value.trim();
    const name = document.getElementById('loginName').value.trim();

    if (!isValidMobile(mobile)) {
        alert('❌ कृपया 10 अंकों का एक मान्य मोबाइल नंबर डालें।');
        return;
    }

    if (!isValidName(name) || name.length < 2) {
        alert('❌ कृपया अपना मान्य नाम (केवल अक्षर) डालें।');
        return;
    }
    
    // ... (rest of the login logic)
    currentUser = { mobile, name, userId: 'USER_' + Date.now() };
    localStorage.setItem('busPassUser', JSON.stringify(currentUser));
    
    // Save to DynamoDB (API call)
    saveUserToDB(currentUser);

    checkLoginStatus();
    closeModal('loginModal');
}

// Proceed to Pay फंक्शन में बाधाएं
function proceedToPay() {
    if (!currentUser) {
        alert('❌ आगे बढ़ने के लिए कृपया पहले लॉगिन करें।');
        showLoginModal();
        return;
    }

    if (!selectedPassType) {
        alert('❌ कृपया एक पास प्रकार (Daily, Weekly, Monthly) चुनें।');
        return;
    }

    const fromStop = document.getElementById('fromStop').value;
    const toStop = document.getElementById('toStop').value;
    const name = document.getElementById('passengerName').value.trim();
    const mobile = document.getElementById('mobileNumber').value.trim();
    const email = document.getElementById('emailAddress').value.trim();

    if (!fromStop || !toStop) {
        alert('❌ कृपया यात्रा का मार्ग (From Stop और To Stop) चुनें।');
        return;
    }
    
    if (fromStop === toStop) {
        alert('❌ प्रारंभिक स्टॉप (From Stop) और गंतव्य स्टॉप (To Stop) समान नहीं हो सकते।');
        return;
    }

    if (!isValidName(name) || name.length < 2) {
        alert('❌ कृपया यात्री का एक मान्य नाम (केवल अक्षर) डालें।');
        return;
    }

    if (!isValidMobile(mobile)) {
        alert('❌ कृपया 10 अंकों का एक मान्य मोबाइल नंबर डालें।');
        return;
    }

    if (email && !isValidEmail(email)) {
        alert('❌ कृपया एक मान्य ईमेल पता डालें।');
        return;
    }

    const totalAmount = document.getElementById('totalAmount').textContent;
    document.getElementById('payAmount').textContent = totalAmount;
    document.getElementById('paymentModal').classList.add('active');
}



