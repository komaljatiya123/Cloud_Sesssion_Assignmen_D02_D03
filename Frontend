async function updatePrice() {
    if (!selectedPrice) return;
    
    const discount = document.getElementById('discount').value;
    
    // 🛑 New: Fare calculation ko backend (Lambda) se fetch karein
    try {
        const response = await fetch(`${API_BASE_URL}/fare`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ selectedPrice: selectedPrice, discountType: discount })
        });

        if (response.ok) {
            const data = await response.json();
            const finalPrice = data.finalAmount;
            document.getElementById('totalAmount').textContent = '₹' + finalPrice;
        } else {
            // Error hone par client-side fallback
            console.error('Fare API failed, using client-side fallback.');
            let finalPrice = selectedPrice;
            if (discount === 'student') finalPrice = selectedPrice * 0.8;
            else if (discount === 'senior') finalPrice = selectedPrice * 0.5;
            document.getElementById('totalAmount').textContent = '₹' + Math.round(finalPrice);
        }
    } catch (error) {
        // Network error hone par client-side fallback
        console.error('Fare API network error, using client-side fallback:', error);
        let finalPrice = selectedPrice;
        if (discount === 'student') finalPrice = selectedPrice * 0.8;
        else if (discount === 'senior') finalPrice = selectedPrice * 0.5;
        document.getElementById('totalAmount').textContent = '₹' + Math.round(finalPrice);
    }
}

